# ArtAround Environment Configuration
# Copy this file to src/config/.env and fill in your values

# Server
NODE_ENV=development
PORT=8000

# Database (MongoDB)
DB_HOST=localhost
DB_USER=site242557
DB_PASS=your_password_here
DB_NAME=artaround

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# OpenAI API (Tier 3)
OPENAI_API_KEY=sk-your-openai-api-key